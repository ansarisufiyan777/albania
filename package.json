{
  "name": "albania",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "stash=\"$(mktemp -d)\"; if [ -d public/gallery ]; then mv public/gallery \"$stash/gallery\"; fi; trap 'if [ -d \"$stash/gallery\" ]; then mv \"$stash/gallery\" public/gallery; fi; rm -rf \"$stash\"' EXIT; vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "gallery:manifest": "node scripts/generate-gallery-manifest.mjs",
    "vault:encrypt": "node scripts/vault-encrypt.mjs",
    "vault:rekey": "node scripts/vault-rekey.mjs",
    "vault:sync": "node scripts/vault-sync.mjs",
    "hooks:install": "git config core.hooksPath hooks"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "hash-wasm": "^4.12.0",
    "sharp": "^0.33.5",
    "vite": "^5.0.0"
  }
}
